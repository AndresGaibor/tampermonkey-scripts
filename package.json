{
  "name": "andres-userscripts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Monorepo para desarrollar varios userscripts con Bun, Vite y vite-plugin-monkey.",
  "scripts": {
    "list": "bun tools/list.ts",
    "bump:userscripts": "bun tools/bump-userscript-versions.ts",
    "dev:sri": "bun tools/vite.ts dev sri-comprobantes",
    "build:sri": "bun tools/vite.ts build sri-comprobantes",
    "dev:demo": "bun tools/vite.ts dev demo-current-site",
    "build:demo": "bun tools/vite.ts build demo-current-site",
    "dev:better-chatgpt-assistant": "bun tools/vite.ts dev better-chatgpt-assistant",
    "build:better-chatgpt-assistant": "bun tools/vite.ts build better-chatgpt-assistant",
    "build:all": "bun tools/build-all.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vite-plugin-monkey": "latest"
  }
}
